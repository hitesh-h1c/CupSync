# --- Database ---
# Local dev: mongodb://localhost:27017/cupsync_app
# Production: your MongoDB Atlas connection string
MONGODB_URI="mongodb://localhost:27017/cupsync_app"

# --- Auth (Auth.js / NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Public base URL of the app
NEXTAUTH_URL="http://localhost:3000"

# --- Super Admin seed (used by `npm run seed`) ---
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL="admin@cupsync.app"
SUPER_ADMIN_PASSWORD="ChangeMe!123"

# --- Email (Phase 8 — daily summary) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Cup Sync <no-reply@cupsync.app>"

# --- Cron (Phase 8 — secures /api/cron/daily-summary) ---
CRON_SECRET="change-me-cron-secret"
